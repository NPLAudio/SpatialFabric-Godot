#!/usr/bin/env python
# Builds the GDExtension against godot-cpp fetched by Tools/build_native.py (never vendored).
import os
env = SConscript(os.path.join("..", ".deps", "godot-cpp", "SConstruct"))
vendor = os.path.join("..", "vendor", "sf_audio")
env.Append(CPPPATH=[os.path.join("src"), vendor])
env.Append(CPPDEFINES=["SF_AUDIO_BUILD"])
if env["platform"] == "windows":
    env.Append(LIBS=["ole32", "oleaut32", "avrt", "uuid"])
elif env["platform"] == "macos":
    env.Append(LINKFLAGS=["-framework", "AudioToolbox", "-framework", "CoreAudio", "-framework", "CoreFoundation"])
sources = [os.path.join("src", "spatialfabric_native.cpp"), os.path.join(vendor, "src", "audio.cpp")]
output = os.path.join("..", "..", "addons", "spatial_fabric", "bin", "spatialfabric_native{}{}".format(env["suffix"], env["SHLIBSUFFIX"]))
library = env.SharedLibrary(output, source=sources)
Default(library)
